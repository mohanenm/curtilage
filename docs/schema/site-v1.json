{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohanenm/curtilage/blob/main/docs/schema/site-v1.json",
  "title": "curtilage site, version 1",
  "description": "One line of `curtilage generate --format ndjson`: a GeoJSON Feature holding one site's premises. Version 1 only gains optional properties; a change that removes or retypes one gets a new file.",
  "type": "object",
  "required": [
    "type",
    "geometry",
    "properties"
  ],
  "properties": {
    "type": {
      "const": "Feature"
    },
    "geometry": {
      "$ref": "#/$defs/polygon_or_null",
      "description": "The premises (closed, convex ring of [lng, lat]); null when none could be made."
    },
    "properties": {
      "type": "object",
      "required": [
        "id",
        "role",
        "ok",
        "confidence",
        "confidence_factors",
        "method",
        "flags",
        "building",
        "details",
        "errors",
        "warnings",
        "metrics",
        "explanation",
        "steps",
        "attribution",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The site's id from the input, or its position from 1."
        },
        "role": {
          "const": "premises"
        },
        "ok": {
          "type": "boolean",
          "description": "The premises passed validation. Never use one that isn't."
        },
        "pin_quality": {
          "type": [
            "object",
            "null"
          ],
          "description": "Where the pin was given and how far from the nearest building; moved_from when snapped.",
          "properties": {
            "quality": {
              "enum": [
                "on_building",
                "on_road",
                "near_building",
                "far"
              ]
            },
            "building_m": {
              "type": "number"
            },
            "moved_from": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How far to trust the result (rule-based; see the reference). 0 when not ok."
        },
        "confidence_factors": {
          "type": "array",
          "description": "Every factor behind the confidence: when one isn't met, its weight comes off 1.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "met",
              "weight"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "met": {
                "type": "boolean"
              },
              "weight": {
                "type": "number"
              }
            }
          }
        },
        "method": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "grow_trim",
            "building",
            null
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Review flags (see the reference)."
        },
        "building": {
          "description": "The id of the building used, or null."
        },
        "details": {
          "type": [
            "object",
            "null"
          ],
          "description": "Facts about the site (building, parking_area_m2, parking_spaces_estimate, frontage_m, access_points); null when no premises were made."
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "object"
        },
        "explanation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Each step in plain words."
        },
        "steps": {
          "type": "array",
          "description": "The explanation as records, one per line in the same order (see the reference for step names and rules).",
          "items": {
            "type": "object",
            "required": [
              "step",
              "text"
            ],
            "properties": {
              "step": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "features": {
                "type": "array"
              },
              "distance_m": {
                "type": "number"
              },
              "area_before_m2": {
                "type": "number"
              },
              "area_after_m2": {
                "type": "number"
              },
              "flag": {
                "type": "string"
              }
            }
          }
        },
        "attribution": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Credit these wherever the result is shown."
        },
        "provenance": {
          "type": "object",
          "required": [
            "gem_version"
          ],
          "properties": {
            "gem_version": {
              "type": "string"
            },
            "data": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "source": {
                  "enum": [
                    "overture",
                    "geofabrik",
                    "parquet"
                  ]
                },
                "release": {
                  "type": "string",
                  "description": "Overture release, e.g. 2026-11-18.0."
                },
                "regions": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            "features_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "options": {
              "type": "object",
              "description": "Every generation option after defaults."
            }
          }
        },
        "store": {
          "$ref": "#/$defs/polygon_or_null",
          "description": "The store zone (the building's outline, inside the premises); absent with --no-store."
        },
        "approach": {
          "$ref": "#/$defs/polygon_or_null",
          "description": "The approach zone (the premises grown by approach_m, simplified); only with --approach."
        },
        "pickup": {
          "$ref": "#/$defs/polygon_or_null",
          "description": "The pickup zone, always estimated (mapped parking within pickup_m of the building, inside the premises); only with --pickup, and absent when none was found."
        },
        "staging": {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "description": "The staging point, always estimated (the pickup zone's point nearest the building); only with a pickup zone."
        },
        "candidates": {
          "type": "array",
          "description": "Other premises the site could have, most confident first; only with --candidates.",
          "items": {
            "type": "object",
            "required": [
              "rank",
              "geometry",
              "confidence",
              "flags"
            ],
            "properties": {
              "rank": {
                "type": "integer"
              },
              "geometry": {
                "$ref": "#/$defs/polygon_or_null"
              },
              "confidence": {
                "type": "number"
              },
              "flags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "building": {},
              "method": {
                "type": "string"
              },
              "explanation": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "polygon_or_null": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
