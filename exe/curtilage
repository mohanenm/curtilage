#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "optparse"
require "json"
require "tmpdir"
require "curtilage"

USAGE = <<~TEXT
  Usage:
    curtilage generate (--pin LNG,LAT ... | --in FILE) [--out FILE] [options]
    curtilage preview (--pin LNG,LAT ... | --in FILE) [--out FILE] [options]
    curtilage build REGION [options]
    curtilage doctor

  generate   The premises (and store zone) for one or more pins, as GeoJSON,
             CSV or KML. Pins from --pin or a CSV/GeoJSON file. Map data is
             fetched as needed: nothing to set up or host.
  preview    Generate, then write an HTML page with a map of each site to
             check by eye (it loads nothing from the internet).
  build      Build a region's map data ahead of time (a US state such as
             "tennessee", or a Geofabrik path such as "europe/germany/bayern").
  doctor     Check that DuckDB and its extensions are ready.

  Run "curtilage COMMAND --help" for a command's options.
TEXT

def duckdb_flags(parser, opts)
  parser.on("--duckdb PATH", "DuckDB CLI (default: $CURTILAGE_DUCKDB or duckdb on PATH)") { |v| opts[:duckdb] = v }
  parser.on("--extension-directory DIR", "DuckDB extension folder (default: $CURTILAGE_EXTENSIONS)") do |v|
    opts[:extension_directory] = File.expand_path(v)
  end
end

def generate_options(args, command)
  opts = { pins: [] }
  OptionParser.new do |o|
    o.banner = "Usage: curtilage #{command} (--pin LNG,LAT ... | --in FILE) [--out FILE] [options]"
    io_flags(o, opts, command)
    data_flags(o, opts)
    style_flags(o, opts)
    duckdb_flags(o, opts)
  end.parse!(args)
  opts
end

def io_flags(o, opts, command)
  o.on("--pin LNG,LAT", "A location; repeat for several") { |v| opts[:pins] << v }
  o.on("--in FILE", "Pins from a CSV (lng and lat columns, optional id) or GeoJSON (Point features)") do |v|
    opts[:in] = v
  end
  if command == "preview"
    o.on("--out FILE", "Where to write the page (default: curtilage-preview.html)") { |v| opts[:out] = v }
    o.on("--buffer METRES", Float, "Also draw the premises grown by this much (a geofence margin)") do |v|
      opts[:buffer] = v
    end
  else
    o.on("--out FILE", "Write here instead of printing; the format follows the extension") { |v| opts[:out] = v }
    o.on("--format NAME", Curtilage::Formats::OUTPUTS.map(&:to_s), "geojson (default), csv or kml") do |v|
      opts[:format] = v.to_sym
    end
  end
end

# [pins, ids] from --pin and --in.
def read_sites(opts, command)
  sites = opts[:pins].map.with_index(1) { |pin, i| { id: i.to_s, pin: Curtilage::Formats.pin_from_text(pin) } }
  sites += Curtilage::Formats.read_pins(opts[:in]) if opts[:in]
  abort "curtilage #{command}: give --pin LNG,LAT or --in FILE" if sites.empty?
  bad = sites.find { |s| !Curtilage::Formats.pin?(s[:pin]) }
  abort "curtilage #{command}: #{bad[:id]}: a pin is LNG,LAT (longitude first)" if bad
  [sites.map { |s| s[:pin] }, sites.map { |s| s[:id] }]
rescue ArgumentError, SystemCallError => e
  abort "curtilage #{command}: #{e.message}"
end

def run(opts, pins, **extra)
  catalogue = opts[:catalogue] && Curtilage::Catalogue.from_dir(opts[:catalogue])
  Curtilage.generate_many(pins, catalogue: catalogue, **opts.slice(:parquet, :source, :cache_dir),
                                lookup: opts.slice(:duckdb, :extension_directory),
                                **opts.slice(:preset, :buildings, :store_zone), **extra)
rescue Curtilage::Error, ArgumentError => e
  abort "curtilage: #{e.message}"
end

def data_flags(o, opts)
  o.on("--source NAME", %w[auto geofabrik overture],
       "auto (default: Overture for scattered pins, Geofabrik builds for many), geofabrik or overture") do |v|
    opts[:source] = v.to_sym
  end
  o.on("--cache-dir DIR", "Keep on-demand builds here and reuse them for a month") { |v| opts[:cache_dir] = v }
  o.on("--catalogue DIR", "Use regions built ahead of time (curtilage build)") { |v| opts[:catalogue] = v }
  o.on("--parquet FILE", "Use one built region file") { |v| opts[:parquet] = v }
end

def style_flags(o, opts)
  o.on("--preset NAME", Curtilage::PRESETS.keys.map(&:to_s), "whole_lot (default), tight or centre") do |v|
    opts[:preset] = v.to_sym
  end
  o.on("--buildings FLAVOUR", Curtilage::Generator::BUILDING_SOURCES.map(&:to_s),
       "osm (default), osm_filled or ml") { |v| opts[:buildings] = v.to_sym }
  o.on("--[no-]store", "Include the store zone (default: yes)") { |v| opts[:store_zone] = v }
end

# Refuses an output path that's a symbolic link (it could point anywhere),
# before any work is done.
def check_out(path, command)
  abort "curtilage #{command}: #{path} is a symbolic link; refusing to write through it" if path && File.symlink?(path)
end

# Writes next to the target and renames, so a reader never sees half a file
# and an interrupted run leaves the old one in place.
def write_out(path, text, command)
  check_out(path, command)
  part = File.join(File.dirname(File.expand_path(path)), ".#{File.basename(path)}.#{Process.pid}.part")
  File.write(part, text)
  File.rename(part, path)
rescue SystemCallError => e
  FileUtils.rm_f(part) if part
  abort "curtilage #{command}: can't write #{path}: #{e.message}"
end

def generate(args)
  opts = generate_options(args, "generate")
  format = opts[:format] || Curtilage::Formats.format_of(opts[:out]) || :geojson
  check_out(opts[:out], "generate")
  pins, ids = read_sites(opts, "generate")
  results = run(opts, pins)
  text = Curtilage::Formats.write(results, format, ids: ids, store: opts.fetch(:store_zone, true))
  if opts[:out]
    write_out(opts[:out], text, "generate")
    warn "#{results.count(&:ok?)} of #{results.size} ok; wrote #{opts[:out]}"
  else
    puts text
  end
  exit(results.all?(&:ok?) ? 0 : 1)
end

def preview(args)
  opts = generate_options(args, "preview")
  out = opts[:out] || "curtilage-preview.html"
  check_out(out, "preview")
  pins, ids = read_sites(opts, "preview")
  results = run(opts, pins, keep_features: true)
  write_out(out, Curtilage::Preview.html(results, ids: ids, buffer_m: opts[:buffer]), "preview")
  puts "#{results.count(&:ok?)} of #{results.size} ok; open #{File.expand_path(out)}"
end

def build_options(args)
  opts = { out: "." }
  OptionParser.new do |o|
    o.banner = "Usage: curtilage build REGION [options]"
    o.on("--out DIR", "Where to write REGION.parquet and REGION.json (default: .)") { |v| opts[:out] = v }
    o.on("--work DIR", "Download folder (default: a temporary one)") { |v| opts[:work] = v }
    o.on("--date YYMMDD", /\A\d{6}\z/, "A specific Geofabrik extract date (default: newest)") { |v| opts[:date] = v }
    o.on("--keep-downloads", "Keep downloaded files in the work folder") { opts[:keep] = true }
    o.on("--ml-footprints SOURCE", Curtilage::Footprints::SOURCES, "Add machine-learned footprints (microsoft)") do |v|
      opts[:ml] = v
    end
    duckdb_flags(o, opts)
  end.parse!(args)
  opts
end

def build(args)
  opts = build_options(args)
  region = args.shift or abort "curtilage build: give a REGION, e.g. tennessee"

  # Without --work, a fresh private folder (a fixed name in a shared /tmp
  # could be someone else's), removed afterwards unless downloads are kept.
  work = opts[:work] || Dir.mktmpdir("curtilage-build")
  puts Curtilage::Build.run(region, out_dir: opts[:out], work_dir: work, date: opts[:date],
                                    ml_footprints: opts[:ml], keep_downloads: opts[:keep],
                                    **opts.slice(:duckdb, :extension_directory))
  warn "downloads kept in #{work}" if opts[:keep] && !opts[:work]
rescue Curtilage::Error, ArgumentError => e
  abort "curtilage build: #{e.message}"
ensure
  FileUtils.rm_rf(work) if work && !opts[:work] && !opts[:keep]
end

def doctor(args)
  opts = {}
  OptionParser.new do |o|
    o.on("--verify DIR", "Check each built file in DIR (catalogue or cache folder) against its recorded SHA256") do |v|
      opts[:verify] = v
    end
    duckdb_flags(o, opts)
  end.parse!(args)
  settings = Curtilage.duckdb_options(opts.except(:verify))
  check_duckdb(settings)
  check_extensions(settings)
  verify(opts[:verify]) if opts[:verify]
  puts "Ready."
end

def verify(dir)
  catalogue = Curtilage::Catalogue.from_dir(dir)
  problems = catalogue.verify
  problems.each { |p| warn "  #{p}" }
  abort "#{problems.size} built file(s) in #{dir} don't match their metadata: rebuild them" unless problems.empty?
  puts "Built files: #{catalogue.regions.size} region(s) in #{dir} match their metadata"
rescue Curtilage::Error => e
  abort e.message
end

def check_duckdb(settings)
  version, err, status = Curtilage::DuckDB.capture(settings[:duckdb], "", "--version")
  abort "DuckDB (#{settings[:duckdb]}) failed to run: #{err.strip[0, 300]}" unless status.success?

  puts "DuckDB: #{version.strip} (#{Curtilage::DuckDB.resolve(settings[:duckdb]) || settings[:duckdb]})"
rescue Curtilage::Error => e
  abort e.message
end

def check_extensions(settings)
  dir = settings[:extension_directory]
  sql = [(Curtilage::DuckDB.extension_sql(dir, settings[:duckdb]) if dir),
         Curtilage::DuckDB.load_sql("spatial", "httpfs")].compact.join("\n")
  versions = Curtilage::DuckDB.extension_versions(settings[:duckdb], sql, %w[spatial httpfs])
  abort "DuckDB extensions (spatial, httpfs) could not be loaded" unless versions.size == 2

  puts "Extensions: #{versions.map { |name, v| "#{name} #{v}" }.join(", ")}" \
       "#{" (offline: loaded, not installed)" if Curtilage.offline?}"
rescue Curtilage::Error => e
  abort e.message
end

case ARGV.shift
when "generate" then generate(ARGV)
when "preview" then preview(ARGV)
when "build" then build(ARGV)
when "doctor" then doctor(ARGV)
when "-h", "--help", "help", nil then puts USAGE
else abort USAGE
end
